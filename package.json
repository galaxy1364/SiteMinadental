{
  "name": "mina-dental-enterprise",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:architecture": "node --test test/architecture-contract.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bootstrap": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql && node scripts/migrate.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@vercel/node": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.8.0"
  }
}
