# Public-origin allowlist; comma-separated.
ALLOWED_ORIGINS=https://preview.example.com,https://drmazandarani.ir

# Server-only backend/CRM webhook for the Kimi dental website.
# This is independent from the Base44 dental-management application.
KIMI_SITE_WEBHOOK_URL=https://crm.example.com/api/kimi-site-events
KIMI_SITE_WEBHOOK_SECRET=replace-with-server-secret

# Optional server-only AI Gateway configuration for the website assistant.
AI_GATEWAY_API_KEY=replace-with-server-secret
AI_GATEWAY_MODEL=openai/gpt-5-mini
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
