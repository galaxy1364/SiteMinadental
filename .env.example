# Public-origin allowlist; comma-separated.
ALLOWED_ORIGINS=https://preview.example.com,https://drmazandarani.ir

# Server-only MinaDent/CRM webhook contract.
MINADENT_WEBHOOK_URL=https://minadent.example.com/api/public-events
MINADENT_WEBHOOK_SECRET=replace-with-server-secret

# Optional server-only AI Gateway configuration.
AI_GATEWAY_API_KEY=replace-with-server-secret
AI_GATEWAY_MODEL=openai/gpt-5-mini
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
